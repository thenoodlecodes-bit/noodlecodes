# Copy to .env.local and fill in. On your host (Vercel or similar), add the same keys in its settings.

# Public URL, used for canonical links, sitemap and social cards
NEXT_PUBLIC_SITE_URL=https://noodlecodes.com

# Optional: Google Tag Manager container. Site events are already pushed to dataLayer.
NEXT_PUBLIC_GTM_ID=

# Enquiries and newsletter signups are saved to a Google Sheet through an Apps Script web app.
# Paste the web app URL (ends in /exec). See apps-script/enquiry-sheet.gs.
ENQUIRY_SHEET_URL=

# Optional: also email each enquiry through Resend (https://resend.com).
# The Apps Script above can email you instead, with no extra service.
RESEND_API_KEY=
MAIL_FROM="Noodle Codes <website@noodlecodes.com>"
MAIL_TO=thenoodlecodes@gmail.com
