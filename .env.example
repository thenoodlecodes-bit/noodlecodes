# Copy to .env.local and fill in.

# Public URL, used for canonical links, sitemap and social cards
NEXT_PUBLIC_SITE_URL=https://noodlecodes.com

# Optional: Google Tag Manager container. Site events are already pushed to dataLayer.
NEXT_PUBLIC_GTM_ID=

# Contact form and newsletter delivery through Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM="Noodle Codes <website@noodlecodes.com>"
MAIL_TO=hello@noodlecodes.com
