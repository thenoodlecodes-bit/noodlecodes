# Copy to .env.local and fill in to enable real email delivery from the contact form.
# If RESEND_API_KEY is not set, the API route just logs submissions and returns success.

# https://resend.com  — create a key, verify your domain
RESEND_API_KEY=

# Where contact-form submissions are sent
CONTACT_TO_EMAIL=hello@noodlecodes.dev

# Verified "from" address on your Resend domain
CONTACT_FROM_EMAIL=website@noodlecodes.dev

# Public site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://noodlecodes.dev
